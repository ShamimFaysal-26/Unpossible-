rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated per-device collections and subcollections
    match /devices/{deviceId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Isolated per-user collections and subcollections
    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Top-level fallback matches
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
